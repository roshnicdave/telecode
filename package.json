{
  "name": "@roshnicdave/telecode",
  "version": "1.0.4",
  "description": "Control your coding agent sessions from Telegram. An Agent Plugins 1.0.0 plugin: a portable MCP server plus a skill, for any MCP-capable coding agent.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/roshnicdave/telecode#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roshnicdave/telecode.git"
  },
  "bugs": {
    "url": "https://github.com/roshnicdave/telecode/issues"
  },
  "keywords": [
    "telegram",
    "mcp",
    "agent-plugins",
    "coding-agent",
    "remote-control",
    "sessions"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "telecode": "dist/index.cjs"
  },
  "files": [
    "dist",
    "skills",
    "plugin.json",
    "mcp.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist/index.cjs",
    "start": "node dist/index.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "grammy": "^1.46.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2"
  }
}
