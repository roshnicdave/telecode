# Copy this file to `.env` and fill in your values. `.env` is git-ignored.

# Telegram bot token — create a bot with @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=1234567890:AA-your-token-here

# Optional: lock the bot to your account(s). Comma-separated Telegram user IDs.
# Message your bot and send /id to find your number. Leave empty to allow
# anyone who finds the bot (NOT recommended — it can run prompts and shell).
TELEGRAM_ALLOWED_IDS=
